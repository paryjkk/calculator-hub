NODE_ENV=development

DATABASE_URL=postgresql://calculator:calculator@localhost:5432/calculator

# Optional — omit (or "memory:") to use the in-memory fallback (single node)
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# First admin account — seeded on API boot when both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API CORS allowlist (comma-separated origins)
WEB_ORIGIN=http://localhost:3000,https://calculator-hub-ecru.vercel.app

# Server-side proxy target for auth/me/admin endpoints (Next rewrites)
API_PROXY_URL=http://localhost:3001

# Analytics (optional until approved)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Ads — placeholders render until AdSense account is approved
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Canonical site URL (sitemap/robots/metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
