// Prisma schema — canonical per DATABASE-SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedCalculations SavedCalculation[]
}

model SavedCalculation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  slug      String
  name      String
  inputs    Json
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

/// Optional bilingual content overrides applied on top of code definitions.
model CalculatorOverride {
  slug      String  @id
  titleEn   String?
  titleAr   String?
  shortEn   String?
  shortAr   String?
  descEn    String?
  descAr    String?
  hidden    Boolean @default(false)
  sortOrder Int?
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model UsageEvent {
  id        BigInt   @id @default(autoincrement())
  slug      String
  createdAt DateTime @default(now())

  @@index([slug, createdAt])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  body      String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt(sort: Desc)])
}
